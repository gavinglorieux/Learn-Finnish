  "texts": [
    {
      "title": {
        "fi": "Sää",
        "en": "Weather"
      },
      "kind": "reading",
      "lines": [
        {
          "fi": "Millainen sää / ilma tänään on?",
          "en": "What is the weather like today?"
        },
        {
          "fi": "On kaunis / hyvä ilma.",
          "en": "The weather is beautiful / good."
        },
        {
          "fi": "On huono ilma.",
          "en": "The weather is bad."
        },
        {
          "fi": "Kuinka monta astetta ulkona on?",
          "en": "How many degrees is it outside?"
        },
        {
          "fi": "On +30 astetta. On kuuma. On helle.",
          "en": "It is +30 degrees. It is hot. There is a heatwave."
        },
        {
          "fi": "On +20 astetta. On lämmin.",
          "en": "It is +20 degrees. It is warm."
        },
        {
          "fi": "On +2 astetta. On viileä.",
          "en": "It is +2 degrees. It is cool."
        },
        {
          "fi": "On -15 astetta. On kylmä. On pakkasta.",
          "en": "It is -15 degrees. It is cold. It is freezing (below zero)."
        },
        {
          "fi": "Aurinko paistaa. On aurinkoista.",
          "en": "The sun is shining. It is sunny."
        },
        {
          "fi": "On pilvistä.",
          "en": "It is cloudy."
        },
        {
          "fi": "On puolipilvistä.",
          "en": "It is partly cloudy."
        },
        {
          "fi": "On selkeää.",
          "en": "It is clear."
        },
        {
          "fi": "On sumuista.",
          "en": "It is foggy."
        },
        {
          "fi": "Sataa. On sateista.",
          "en": "It is raining. It is rainy."
        },
        {
          "fi": "Sataa räntää.",
          "en": "It is sleeting."
        },
        {
          "fi": "Sataa lunta.",
          "en": "It is snowing."
        },
        {
          "fi": "Tuulee. On tuulista. On myrsky.",
          "en": "It is windy. It is windy. There is a storm."
        },
        {
          "fi": "On ukkonen.",
          "en": "There is a thunderstorm."
        }
      ]
    }
  ],
  "exercises": [],
  "grammar_notes": [
    {
      "topic": "weather",
      "heading": "Weather expressions",
      "text": "Weather sentences have no subject: \"On pilvistä\", \"Sataa\", \"Tuulee\". Adjectives in -inen describing weather are in the partitive: aurinkoista, pilvistä, sumuista, sateista, tuulista, selkeää. What falls is partitive: sataa lunta / räntää. Temperature: \"On +20 astetta\" (aste → astetta after a number)."
    }
  ]

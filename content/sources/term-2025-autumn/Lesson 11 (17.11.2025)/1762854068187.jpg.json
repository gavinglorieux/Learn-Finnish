 "grammar_notes": [
  {
   "topic": "inner-local-cases",
   "heading": "ssa/ssä — sisällä (inside)",
   "text": "The inessive -ssa/-ssä means 'inside': Mies on autossa. Teksti on kirjassa. Rahat ovat pankkiautomaatissa. He istuvat saunassa. Cities normally take -ssa/-ssä: Helsingissä, Oulussa, New Yorkissa, Delhissä."
  },
  {
   "topic": "outer-local-cases",
   "heading": "lla/llä — päällä (on top of), lähellä (near)",
   "text": "The adessive -lla/-llä means 'on top of' (Auto on tiellä. Kirja on pöydällä.) or 'near / at' (Minä olen pankkiautomaatilla. He istuvat saunalla.). Some Finnish cities take -lla/-llä: Tampereella, Vantaalla, Rovaniemellä, Imatralla. HUOM! also: asemalla, kurssilla, lomalla, ulkomailla, matkalla.",
   "table": [
    [
     "ssa/ssä (sisällä)",
     "lla/llä (päällä / lähellä)"
    ],

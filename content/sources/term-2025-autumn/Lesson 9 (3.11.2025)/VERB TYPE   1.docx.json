  "grammar_notes": [
    {
      "topic": "verb-types",
      "heading": "Verbit suomenkielessä",
      "text": "Five verb types (1–5, plus a small type 6), categorised by how the infinitive ends; all infinitives end in -a/-ä. Conjugate by dropping letters from the end and adding the personal ending. Subject pronouns minä/sinä/me/te can be dropped; hän/he cannot.",
      "table": [
        [
          "minä",
          "-n"
        ],
        [
          "sinä",
          "-t"
        ],
        [
          "hän",
          "double vowel"
        ],
        [
          "me",
          "-mme"
        ],
        [
          "te",
          "-tte"
        ],
        [
          "he",
          "-vat/-vät"
        ]
      ]
    },
    {
      "topic": "negation",
      "heading": "Negative",
      "text": "Take the minä form, remove the -n, and use it after the negative verb: minä en, sinä et, hän ei, me emme, te ette, he eivät. puhua > minä puhun > minä en puhu, hän ei puhu, he eivät puhu, me emme puhu."
    },
    {
      "topic": "questions-ko",
      "heading": "Question",
      "text": "Conjugated verb + -ko/-kö first, then the subject: Puhutko sinä suomea? Puhuuko hän suomea? Puhuvatko he suomea? Puhutteko te suomea?"
    },
    {
      "topic": "verb-type-1",
      "heading": "Verb type 1: asua, kysyä, maksaa…",
      "text": "Type 1 verbs end in two vowels (asua, kysyä, maksaa, vetää, puhua). Remove the last a/ä and add the personal ending; in the hän form double the remaining vowel (kysyy, asuu, sanoo, pitää).",
      "table": [
        [
          "kysyä",
          "kysyn, kysyt, kysyy, kysymme, kysytte, kysyvät"
        ],
        [
          "puhua",
          "puhun, puhut, puhuu, puhumme, puhutte, puhuvat"
        ],
        [
          "asua",
          "asun, asut, asuu, asumme, asutte, asuvat"
        ],
        [
          "maksaa",
          "maksan, maksat, maksaa, maksamme, maksatte, maksavat"
        ],
        [
          "rakastaa",
          "rakastan, rakastat, rakastaa, rakastamme, rakastatte, rakastavat"
        ],
        [
          "saunoa",
          "saunon, saunot, saunoo, saunomme, saunotte, saunovat"
        ]
      ]
    }
  ]

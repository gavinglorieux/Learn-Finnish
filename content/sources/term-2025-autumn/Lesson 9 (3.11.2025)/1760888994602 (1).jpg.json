  "texts": [
    {
      "title": {
        "fi": "Sairastaminen",
        "en": "Being ill"
      },
      "kind": "reading",
      "lines": [
        {
          "fi": "Minä olen sairas. Minulla on flunssa.",
          "en": "I am ill. I have the flu."
        },
        {
          "fi": "Oletko sinä sairas? Onko sinulla flunssa?",
          "en": "Are you ill? Do you have the flu?"
        },
        {
          "fi": "Minulla on yskä.",
          "en": "I have a cough."
        },
        {
          "fi": "Minulla on nuha.",
          "en": "I have a runny nose / a cold."
        },
        {
          "fi": "Minulla on kurkku kipeä.",
          "en": "I have a sore throat."
        },
        {
          "fi": "Minulla on kuumetta. Minulla on flunssa.",
          "en": "I have a fever. I have the flu."
        },
        {
          "fi": "Minulla on vatsa kipeä.",
          "en": "I have a stomach ache."
        },
        {
          "fi": "Minulla on korva kipeä.",
          "en": "I have an earache."
        },
        {
          "fi": "Minulla on selkä kipeä.",
          "en": "My back hurts."
        },
        {
          "fi": "Minulla on hammas kipeä.",
          "en": "I have a toothache."
        },
        {
          "fi": "Minulla on kuuma.",
          "en": "I am hot."
        },
        {
          "fi": "Minulla on kylmä.",
          "en": "I am cold."
        },
        {
          "fi": "Minulla on paha olo.",
          "en": "I feel sick / unwell."
        },
        {
          "fi": "Kysy naapurilta:",
          "en": "Ask your neighbour:"
        },
        {
          "fi": "Mikä sinua vaivaa?",
          "en": "What's wrong with you? (What is bothering you?)"
        },
        {
          "fi": "Oletko sinä vilustunut?",
          "en": "Have you caught a cold?"
        },
        {
          "fi": "Onko sinulla flunssa?",
          "en": "Do you have the flu?"
        },
        {
          "fi": "Onko sinulla yskä?",
          "en": "Do you have a cough?"
        },
        {
          "fi": "Entä nuha?",
          "en": "What about a runny nose?"
        },
        {
          "fi": "Onko sinulla kuumetta?",
          "en": "Do you have a fever?"
        },
        {
          "fi": "Onko sinulla selkä kipeä?",
          "en": "Does your back hurt?"
        },
        {
          "fi": "Flunssan oireet: kuume, päänsärky, yskä, kurkkukipu ja nuha.",
          "en": "Flu symptoms: fever, headache, cough, sore throat and runny nose."
        },
        {
          "fi": "Parane pian!",
          "en": "Get well soon!"
        }
      ]
    }
  ],

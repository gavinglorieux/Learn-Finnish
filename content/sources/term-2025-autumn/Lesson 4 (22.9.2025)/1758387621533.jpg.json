      "title": {
        "fi": "Pertti Hyvärinen",
        "en": "Pertti Hyvärinen"
      },
      "kind": "reading",
      "lines": [
        {
          "fi": "Minun nimi on Pertti Hyvärinen.",
          "en": "My name is Pertti Hyvärinen."
        },
        {
          "fi": "Minä olen 29-vuotias suomalainen mies.",
          "en": "I am a 29-year-old Finnish man."
        },
        {
          "fi": "Minä en ole naimisissa.",
          "en": "I am not married."
        },
        {
          "fi": "Minulla on avovaimo.",
          "en": "I have a common-law wife (partner)."
        },
        {
          "fi": "Hänen nimi on Marja-Liisa.",
          "en": "Her name is Marja-Liisa."
        },
        {
          "fi": "Hän on 31 vuotta vanha.",
          "en": "She is 31 years old."
        },
        {
          "fi": "Meillä on kolme lasta: Juhani, Tero ja Teemu.",
          "en": "We have three children: Juhani, Tero and Teemu."
        },
        {
          "fi": "Kolme poikaa.",
          "en": "Three boys."
        },
        {
          "fi": "Juhani on 11, Tero on 8 ja Teemu on 5.",
          "en": "Juhani is 11, Tero is 8 and Teemu is 5."
        },
        {
          "fi": "Minä olen poliisi ja Marja-Liisa on ammatiltaan sairaanhoitaja.",
          "en": "I am a police officer and Marja-Liisa is a nurse by profession."
        },
        {
          "fi": "Meillä on myös kaksi koiraa: Pietu ja Jaska.",
          "en": "We also have two dogs: Pietu and Jaska."
        },
        {
          "fi": "Pietu on minun poliisikoira ja Jaska on Marja-Liisan vanha labradori.",
          "en": "Pietu is my police dog and Jaska is Marja-Liisa's old Labrador."
        },
        {
          "fi": "Se on jo yli kymmenen vuotta vanha.",
          "en": "It is already over ten years old."
        },
        {
          "fi": "Pietu on nuori malinois.",
          "en": "Pietu is a young Malinois."
        }
      ]
    },
    {
      "title": {
        "fi": "Kyllä / ei -vastaukset",
        "en": "Yes / no answers"
      },
      "kind": "dialogue",
      "lines": [

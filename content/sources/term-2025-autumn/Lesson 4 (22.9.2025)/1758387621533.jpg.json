          "en": "Yes. / No."
        },
        {
          "speaker": "A",
          "fi": "Oletteko te naimisissa?",
          "en": "Are you (pl.) married?"
        },
        {
          "speaker": "B",
          "fi": "Olemme. / Emme ole.",
          "en": "Yes. / No."
        },
        {
          "speaker": "A",
          "fi": "Ovatko he naimisissa?",

  "texts": [
    {
      "title": {
        "fi": "Kysymyssanat – esimerkit",
        "en": "Question words – examples"
      },
      "kind": "reading",
      "lines": [
        {
          "fi": "Mikä sinun nimi on?",
          "en": "What is your name?"
        },
        {
          "fi": "Mikä sinun ammatti on?",
          "en": "What is your profession?"
        },
        {
          "fi": "Mikä tämä on?",
          "en": "What is this?"
        },
        {
          "fi": "Mitä sinä teet?",
          "en": "What are you doing?"
        },
        {
          "fi": "Mitä sinulle kuuluu?",
          "en": "How are you?"
        },
        {
          "fi": "Mitä sinä syöt aamulla?",
          "en": "What do you eat in the morning?"
        },
        {
          "fi": "Kuka hän on?",
          "en": "Who is he/she?"
        },
        {
          "fi": "Kuka sinä olet?",
          "en": "Who are you?"
        },
        {
          "fi": "Kuka Englannin pääministeri on nyt?",
          "en": "Who is the Prime Minister of England now?"
        },
        {
          "fi": "Kenen laukku tämä on?",
          "en": "Whose bag is this?"
        },
        {
          "fi": "Kenen kanssa hän on naimisissa?",
          "en": "Who is she married to?"
        },
        {
          "fi": "Minkä maalainen sinä olet / hän on?",
          "en": "What nationality are you / is he/she?"
        },
        {
          "fi": "Kuinka vanha sinä olet?",
          "en": "How old are you?"
        },
        {
          "fi": "Kuinka pitkä sinä olet?",
          "en": "How tall are you?"
        },
        {
          "fi": "Miten menee?",
          "en": "How is it going?"
        },
        {
          "fi": "Kuinka kylmä ulkona on?",
          "en": "How cold is it outside?"
        },
        {
          "fi": "Kuinka sinä matkustat töihin?",
          "en": "How do you travel to work?"
        },
        {
          "fi": "Kuinka usein?",
          "en": "How often?"
        },
        {
          "fi": "Miksi sinulla on kartta mukana?",
          "en": "Why do you have a map with you?"
        },
        {
          "fi": "Miksi sinä olet väsynyt?",
          "en": "Why are you tired?"
        },
        {
          "fi": "Miksi opiskelet suomea?",
          "en": "Why are you studying Finnish?"
        },
        {
          "fi": "Millainen sinun pomo on?",
          "en": "What is your boss like?"
        },
        {
          "fi": "Millainen Helsinki on?",
          "en": "What is Helsinki like?"
        },
        {
          "fi": "Milloin sinulla on syntymäpäivä?",
          "en": "When is your birthday?"
        },
        {
          "fi": "Milloin olet töissä?",
          "en": "When are you working / at work?"
        },
        {
          "fi": "Missä sinä olet?",
          "en": "Where are you?"
        },
        {
          "fi": "Missä te asutte?",
          "en": "Where do you live?"
        },
        {
          "fi": "Missä sinä haluat istua?",
          "en": "Where do you want to sit?"
        },
        {
          "fi": "Mistä te tulette?",
          "en": "Where do you come from?"
        },
        {
          "fi": "Mistä hän on kotoisin?",
          "en": "Where is he/she from?"
        },
        {
          "fi": "Mistä he puhuvat?",
          "en": "What are they talking about?"
        },
        {
          "fi": "Mistä sinä tykkäät?",
          "en": "What do you like?"
        },
        {
          "fi": "Mihin te menette?",
          "en": "Where are you going?"
        },
        {
          "fi": "Mihin sinä matkustat kesällä?",
          "en": "Where are you travelling in summer?"
        },
        {
          "fi": "Mihin he lähtevät huomenna?",
          "en": "Where are they leaving for tomorrow?"
        },
        {
          "fi": "Mihin aikaan te tulette?",
          "en": "What time are you coming?"
        },
        {
          "fi": "Mihin aikaan juna lähtee?",
          "en": "What time does the train leave?"
        },
        {
          "fi": "Mihin aikaan kurssi alkaa?",
          "en": "What time does the course start?"
        }

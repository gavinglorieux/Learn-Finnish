  "texts": [
    {
      "title": {
        "fi": "Mikä sinun nimi on?",
        "en": "What's your name?"
      },
      "kind": "dialogue",
      "lines": [
        {
          "speaker": "Anna",
          "fi": "Moi! Mikä sinun nimi on?",
          "en": "Hi! What's your name?"
        },
        {
          "speaker": "Juan",
          "fi": "Minun nimi on Juan. Mikä sinun nimi on?",
          "en": "My name is Juan. What's your name?"
        },
        {
          "speaker": "Anna",
          "fi": "Minä olen Anna.",
          "en": "I'm Anna."
        },
        {
          "speaker": "Juan",
          "fi": "Mikä sinun sukunimi on?",
          "en": "What's your surname?"
        },
        {
          "speaker": "Anna",
          "fi": "Heinonen. Entä sinun?",
          "en": "Heinonen. How about yours?"
        },
        {
          "speaker": "Juan",
          "fi": "Garcia.",
          "en": "Garcia."
        },
        {
          "speaker": "Anna",
          "fi": "Oletko sinä portugalilainen?",
          "en": "Are you Portuguese?"
        },
        {
          "speaker": "Juan",
          "fi": "En. Minä olen meksikolainen.",
          "en": "No. I'm Mexican."
        },
        {
          "speaker": "Anna",
          "fi": "Onko tuo sinun tyttöystävä?",
          "en": "Is that your girlfriend?"
        },
        {
          "speaker": "Juan",
          "fi": "Joo. Hän on suomalainen.",
          "en": "Yeah. She's Finnish."
        },
        {
          "speaker": "Anna",
          "fi": "Mikä hänen nimi on?",
          "en": "What's her name?"
        },
        {
          "speaker": "Juan",
          "fi": "Tiina. Hän on näyttelijä. Mikä sinun ammatti on?",
          "en": "Tiina. She's an actress. What's your profession?"
        },
        {
          "speaker": "Anna",
          "fi": "Minä olen myyjä.",
          "en": "I'm a shop assistant."
        },
        {
          "speaker": "Juan",
          "fi": "Minä olen ensihoitaja. Oli kiva tavata.",
          "en": "I'm a paramedic. It was nice to meet you."
        },
        {
          "speaker": "Anna",
          "fi": "Joo. Nähdään myöhemmin! Moikka!",
          "en": "Yeah. See you later! Bye!"
        }
      ]
    },
    {
      "title": {
        "fi": "Pyöräkaupassa: kenen vuoro?",
        "en": "At the bike shop: whose turn?"
      },
      "kind": "dialogue",
      "lines": [
        {
          "speaker": "Myyjä",
          "fi": "Jaha, ja kenen vuoro?",
          "en": "Alright, and whose turn is it?"
        },
        {
          "speaker": "Simo",
          "fi": "Minun! Mikä tämän pyörän hinta on?",
          "en": "Mine! What's the price of this bike?"
        },
        {
          "speaker": "Myyjä",
          "fi": "Sen hinta on aika korkea. 450 euroa.",
          "en": "Its price is rather high. 450 euros."
        },
        {
          "speaker": "Simo",
          "fi": "Ja mikä tuon pyörän hinta on?",
          "en": "And what's the price of that bike?"
        },
        {
          "speaker": "Myyjä",
          "fi": "Se on vähän halvempi. Se on 385 euroa.",
          "en": "It's a bit cheaper. It's 385 euros."
        },
        {
          "speaker": "Simo",
          "fi": "Selvä. Kiitos.",
          "en": "OK. Thanks."
        },
        {
          "speaker": "Myyjä",
          "fi": "Ole hyvä. Kenen vuoro? Teidän?",
          "en": "You're welcome. Whose turn? Yours?"
        },
        {
          "speaker": "Riitta ja Pasi",
          "fi": "Joo, meidän vuoro. Onko tämä pyörä suomalainen?",
          "en": "Yes, our turn. Is this bike Finnish?"
        },
        {
          "speaker": "Myyjä",
          "fi": "Hetkinen. Ei, tämän pyörän valmistaja on \"Haagen\". Tämä on belgialainen pyörä.",
          "en": "One moment. No, this bike's manufacturer is \"Haagen\". This is a Belgian bike."
        },
        {
          "speaker": "Riitta ja Pasi",
          "fi": "Okei. Meidän vanha pyörä on suomalainen ja se on tosi hyvä.",
          "en": "Okay. Our old bike is Finnish and it's really good."
        },
        {
          "speaker": "Myyjä",
          "fi": "Tuo pyörä on \"Viikinki\". Se on suomalainen. Se on vähän kalliimpi, mutta kevyt pyörä. Se on alennuksessa ja maksaa nyt vain 525 euroa.",
          "en": "That bike is a \"Viikinki\". It's Finnish. It's a bit more expensive, but a light bike. It's on sale and now costs only 525 euros."
        }
      ]
    }
  ],

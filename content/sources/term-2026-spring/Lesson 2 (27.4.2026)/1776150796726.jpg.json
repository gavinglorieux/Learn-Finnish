  "texts": [
    {
      "title": {
        "fi": "Matka Pariisiin",
        "en": "A trip to Paris (completed exercise text)"
      },
      "kind": "reading",
      "lines": [
        {
          "fi": "Pekka ja minä lähdemme tänään Ranskaan.",
          "en": "Pekka and I are leaving for France today."
        },
        {
          "fi": "Aamulla minä en nuku pitkään, koska me lennämme jo kello 6 lentokoneella Pariisiin.",
          "en": "In the morning I don't sleep long, because we fly to Paris by plane as early as 6 o'clock."
        },
        {
          "fi": "Lentokoneessa minä luen kirjaa ja Pekka nukkuu vähän.",
          "en": "On the plane I read a book and Pekka sleeps a little."
        },
        {
          "fi": "Kun me saavumme Pariisiin, Elise ja Fabian odottavat meitä.",
          "en": "When we arrive in Paris, Elise and Fabian are waiting for us."
        },
        {
          "fi": "He sanovat: \"Tervetuloa! Ymmärrättekö te ranskaa?\"",
          "en": "They say: \"Welcome! Do you understand French?\""
        },
        {
          "fi": "Sitten me ajamme autolla keskustaan ja katsomme kaupunkia.",
          "en": "Then we drive into the centre and look around the city."
        },
        {
          "fi": "Pekka ottaa monta valokuvaa.",
          "en": "Pekka takes lots of photos."
        },
        {
          "fi": "Iltapäivällä minä istun kahvilassa ja kirjoitan postikortit Suomeen.",
          "en": "In the afternoon I sit in a café and write the postcards to Finland."
        },
        {
          "fi": "Pekka menee kioskille ja ostaa Pariisin kartan.",
          "en": "Pekka goes to the kiosk and buys a map of Paris."
        },
        {
          "fi": "Me yövymme Elisen ja Fabianin kotona, mutta me emme löydä taloa heti.",
          "en": "We are staying at Elise and Fabian's home, but we don't find the house straight away."
        },
        {
          "fi": "Siksi Pekka soittaa Eliselle.",
          "en": "So Pekka calls Elise."
        },
        {
          "fi": "Elise kertoo, missä talo on.",
          "en": "Elise tells (him) where the house is."
        }
      ]
    }
  ],

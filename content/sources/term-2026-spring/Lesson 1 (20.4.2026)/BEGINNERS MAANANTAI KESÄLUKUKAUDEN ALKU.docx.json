  "texts": [
    {
      "title": {
        "fi": "Jokisen perhe puistossa",
        "en": "The Jokinen family in the park"
      },
      "kind": "reading",
      "lines": [
        {
          "fi": "Jokisen perhe on kävelyllä puistossa.",
          "en": "The Jokinen family is out for a walk in the park."
        },
        {
          "fi": "Tänään on viileä päivä.",
          "en": "Today is a cool day."
        },
        {
          "fi": "Aurinko ei paista, vaan puistossa tuulee.",
          "en": "The sun isn't shining; instead it's windy in the park."
        },
        {
          "fi": "Pikku Marjaana kerää lehtiä.",
          "en": "Little Marjaana is collecting leaves."
        },
        {
          "fi": "Isä ja Marjaana pysähtyvät monta kertaa, kun Marjaana näkee hienoja lehtiä.",
          "en": "Dad and Marjaana stop many times when Marjaana sees nice leaves."
        },
        {
          "fi": "Hän poimii maasta ison, keltaisen vaahteranlehden ja näyttää sen isälle.",
          "en": "She picks a big yellow maple leaf up from the ground and shows it to Dad."
        },
        {
          "fi": "Marjaanan pikkuveli Marko nukkuu lastenvaunussa.",
          "en": "Marjaana's little brother Marko is sleeping in the pram."
        },
        {
          "fi": "Hän ei herää.",
          "en": "He doesn't wake up."
        },
        {
          "fi": "Äiti työntää lastenvaunua.",
          "en": "Mum is pushing the pram."
        },
        {
          "fi": "Hän kävelee reippaasti.",
          "en": "She walks briskly."
        },
        {
          "fi": "Hän ei halua pysähtyä, koska hänellä on nälkä.",
          "en": "She doesn't want to stop because she is hungry."
        },
        {
          "fi": "Hän ei syö koskaan aamulla.",
          "en": "She never eats in the morning."

      "lines": [
        {
          "fi": "Pedro istuu ikkunan edessä ja soittaa kitaraa.",
          "en": "Pedro is sitting in front of the window playing the guitar."
        },
        {
          "fi": "Oven takana parvekkeella pari vierasta on tupakalla.",
          "en": "Behind the door, on the balcony, a couple of guests are having a smoke."
        },
        {
          "fi": "Pedron ympärillä seisovat Veijo, Jenni ja Sami.",
          "en": "Veijo, Jenni and Sami are standing around Pedro."
        },
        {
          "fi": "He kuuntelevat, kun Pedro soittaa.",
          "en": "They listen while Pedro plays."
        },
        {
          "fi": "Hanna ja Meri katsovat valokuvia pöydän ääressä.",
          "en": "Hanna and Meri are looking at photos at the table."
        },
        {
          "fi": "Pöydän keskellä on kolme isoa kynttilää, koska katossa ei ole vielä lamppua.",
          "en": "In the middle of the table there are three big candles, because there is no lamp on the ceiling yet."
        },
        {
          "fi": "Uusi lamppu odottaa laatikossa kaapin päällä.",
          "en": "The new lamp is waiting in a box on top of the cupboard."
        },
        {
          "fi": "Alex istuu sohvalla kahden tytön välissä.",
          "en": "Alex is sitting on the sofa between two girls."
        },
        {
          "fi": "Alexin oikealla puolella istuu Olga ja Alexin vasemmalla puolella on Janita.",
          "en": "Olga is sitting on Alex's right and Janita is on Alex's left."
        },
        {
          "fi": "He syövät ja juttelevat.",
          "en": "They are eating and chatting."
        },
        {
          "fi": "Pienellä pöydällä sohvan vieressä on popcornia.",
          "en": "On the small table next to the sofa there is popcorn."
        },
        {
          "fi": "Olga haluaa lisää juotavaa – mutta missä hänen lasi on?",
          "en": "Olga wants more to drink – but where is her glass?"
        }
      ]
    }
  ],

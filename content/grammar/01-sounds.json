    {
      "id": "vowel-harmony",
      "title": "Vowel harmony",
      "fi": "Vokaalisointu",
      "emoji": "⚖️",
      "summary": "Endings come in two flavours — -a/-o/-u for 'back' words and -ä/-ö/-y for 'front' words. The word itself decides which one you use.",
      "requires": [
        "pronunciation"
      ],
      "sections": [
        {
          "heading": "Three groups of vowels",
          "table": {
            "headers": [
              "Group",
              "Vowels",
              "Takes endings with"
            ],
            "rows": [
              [
                "Back vowels",
                "a, o, u",
                "a, o, u  (-ssa, -lla, -ko, -vat)"
              ],
              [
                "Front vowels",
                "ä, ö, y",
                "ä, ö, y  (-ssä, -llä, -kö, -vät)"
              ],
              [
                "Neutral vowels",
                "e, i",
                "go with either; a word with only e/i takes front endings"
              ]
            ]
          }
        },
        {
          "heading": "The rule",
          "body": "Look at the word: **if it contains a, o or u anywhere, use the back endings; otherwise use the front endings.** (In compound words, the last part decides: *jää|kaappi* → *jääkaapissa*.)",
          "table": {
            "headers": [
              "Word",
              "Back/front",
              "Inessive",
              "Question",
              "Partitive"
            ],
            "rows": [

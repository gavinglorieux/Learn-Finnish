              "en": "road — language — to take"
            },
            {
              "fi": "suo — Suomi — juoda",
              "en": "swamp — Finland — to drink"
            },
            {
              "fi": "äiti — käydä — pöytä",
              "en": "mother — to visit — table"
            }
          ]
        }

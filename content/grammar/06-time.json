    {
      "id": "weather",
      "title": "Talking about the weather",
      "fi": "Sää",
      "emoji": "🌦️",
      "summary": "Millainen sää on? — Aurinko paistaa. Sataa lunta. On kylmä. Lämpötila on miinus viisi astetta.",
      "requires": ["olla", "partitive"],
      "sections": [
        {
          "heading": "Asking",
          "examples": [
            { "fi": "Millainen sää tänään on?", "en": "What's the weather like today?" },
            { "fi": "Millainen sää Helsingissä on?", "en": "What's the weather like in Helsinki?" },
            { "fi": "Paljonko on lämmintä / pakkasta?", "en": "How warm is it? / How many degrees below zero?" }
          ]
        },
        {
          "heading": "Weather expressions",
          "table": {
            "headers": ["Finnish", "English"],
            "rows": [
              ["Aurinko paistaa. / On aurinkoista.", "The sun is shining. / It's sunny."],
              ["On pilvistä. / On puolipilvistä.", "It's cloudy. / Partly cloudy."],
              ["Sataa. / Sataa vettä.", "It's raining."],
              ["Sataa lunta.", "It's snowing."],
              ["Sataa räntää.", "It's sleeting."],
              ["Tuulee. / On tuulista.", "It's windy."],
              ["On sumuista.", "It's foggy."],
              ["Ukkostaa. / On ukkosta.", "There's a thunderstorm."],
              ["On kuuma / lämmin / viileä / kylmä.", "It's hot / warm / cool / cold."],
              ["On liukasta.", "It's slippery."],
              ["On pakkasta.", "It's below freezing."],
              ["Lämpötila on plus kymmenen astetta.", "The temperature is +10 °C."],
              ["On kymmenen astetta pakkasta. / On miinus kymmenen.", "It's −10 °C."],
              ["On kaksikymmentä astetta lämmintä.", "It's +20 °C."]
            ]
          },
          "note": "Weather sentences have **no subject**: *Sataa.* (not 'it rains'), *On kylmä.* After numbers: **astetta** (partitive of aste, degree)."
        },
        {
          "heading": "Weather words",
          "table": {
            "headers": ["Noun", "", "Adjective", ""],
            "rows": [
              ["aurinko", "sun", "aurinkoinen", "sunny"],
              ["pilvi", "cloud", "pilvinen", "cloudy"],
              ["sade", "rain", "sateinen", "rainy"],
              ["lumi", "snow", "luminen", "snowy"],
              ["tuuli", "wind", "tuulinen", "windy"],
              ["sumu", "fog", "sumuinen", "foggy"],
              ["ukkonen", "thunder", "", ""],

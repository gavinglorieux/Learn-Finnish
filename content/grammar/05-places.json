    {
      "id": "inner-local-cases",
      "title": "In, out of, into: -ssa, -sta, -Vn",
      "fi": "Sisäpaikallissijat: inessiivi, elatiivi, illatiivi",
      "emoji": "🏠",
      "summary": "Inessive -ssa (in), elative -sta (out of / from), illative -Vn (into / to) — for buildings, rooms, containers, towns and most countries.",
      "requires": [
        "local-cases"
      ],
      "sections": [
        {
          "heading": "Inessive -ssa/-ssä — in (Missä?)",
          "body": "Weak grade + **-ssa/-ssä**.",
          "examples": [
            {
              "fi": "Asun Lontoossa. Työskentelen sairaalassa.",
              "en": "I live in London. I work in a hospital."
            },
            {
              "fi": "Maito on jääkaapissa.",
              "en": "The milk is in the fridge."
            },
            {
              "fi": "Lapset ovat koulussa.",
              "en": "The children are at school."
            },
            {
              "fi": "Helsingissä on paljon kahviloita.",
              "en": "There are lots of cafés in Helsinki."
            }
          ]
        },
        {
          "heading": "Elative -sta/-stä — out of, from (Mistä?)",
          "body": "Weak grade + **-sta/-stä**. Also used for *from* (origin), *about* (topic) and with **pitää** (to like).",
          "examples": [
            {
              "fi": "Tulen kaupasta.",
              "en": "I'm coming from the shop."
            },
            {
              "fi": "Olen kotoisin Englannista.",
              "en": "I'm from England."
            },
            {
              "fi": "Otan maidon jääkaapista.",
              "en": "I take the milk out of the fridge."
            },
            {
              "fi": "Pidän kahvista. Puhumme säästä.",
              "en": "I like coffee. We're talking about the weather."
            }
          ]
        },
        {
          "heading": "Illative -Vn / -hVn / -seen — into, to (Mihin?)",
          "body": "Strong grade + the illative ending. See [[illative|How to form the illative]] for the three patterns.",
          "examples": [
            {
              "fi": "Menen kauppaan.",
              "en": "I'm going to the shop."
            },
            {
              "fi": "Matkustan Suomeen ja Ruotsiin.",
              "en": "I'm travelling to Finland and Sweden."
            },
            {
              "fi": "Laitan maidon jääkaappiin.",
              "en": "I put the milk into the fridge."
            },
            {
              "fi": "Menemme huomenna Helsinkiin.",
              "en": "We're going to Helsinki tomorrow."
            }
          ]
        },

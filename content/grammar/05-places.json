      "id": "place-names",
      "title": "-ssa or -lla? Places, towns and countries",
      "fi": "Paikannimet: -ssa vai -lla?",
      "emoji": "🗺️",
      "summary": "Buildings and closed spaces take -ssa; open areas take -lla. Most towns and countries take -ssa, but some Finnish towns and a few countries take -lla.",
      "requires": [
        "inner-local-cases",
        "outer-local-cases"
      ],
      "sections": [
        {
          "heading": "Places in town",
          "table": {
            "headers": [
              "-ssa (inside a building)",
              "-lla (open place / platform / outdoors)"
            ],
            "rows": [
